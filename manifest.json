{
  "manifest_version": 3,
  "name": "FoxLock",
  "version": "1.0.3",
  "description": "Master password lock screen shown at browser launch. Exits the browser on 3 wrong passwords or any bypass attempt. Change the password in the add-on settings.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlock@foxlock.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "auth.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
